<Project>

  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Wessley Mitchell</Authors>
    <Copyright>Copyright 2026 Wessley Mitchell</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.skyrimforge.net/prismaui/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SkyrimForge/SkyrimForge.PrismaUi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
